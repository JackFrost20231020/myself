{
  "name": "shuang",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "「霜」：JackFrost 的方格本。这周在做什么、读了什么、想到了什么",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run --config web/vite.config.ts",
    "typecheck": "tsc -p web --noEmit",
    "check:content": "node web/content/check.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  }
}
