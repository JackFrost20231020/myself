{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhishitupu-site",
  "compatibility_date": "2026-10-01",
  // 只托管 npm run build 生成的静态文件，没有服务端代码。
  // 不存在的地址也返回 index.html，由页面自己决定显示哪一页或 404。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // 清掉旧站每天拉 AIHOT 的定时任务
  "triggers": { "crons": [] }
}
