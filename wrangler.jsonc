{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhishitupu-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // public/ 里的静态文件（CSS、JS、图标）由 Cloudflare 直接返回，其余请求交给 Worker
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhishitupu-site",
      // 部署前运行 `npx wrangler d1 create zhishitupu-site`，把输出的 database_id 填到这里
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 每天 00:30 UTC（北京时间 08:30）拉一次 AIHOT 精选
  "triggers": { "crons": ["30 0 * * *"] },
  "observability": { "enabled": true }
}
